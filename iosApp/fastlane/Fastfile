# TowerScope Live, iPhone. Run from iosApp/:  bundle exec fastlane <lane>
#
# Secrets come only from environment variables (GitHub secrets on CI):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   App Store Connect Team API key (not an Individual key)
#   MATCH_PASSWORD, MATCH_GIT_URL                  fastlane match, private certs repo
#   MATCH_GIT_BASIC_AUTHORIZATION                  base64 "user:token" with read access to that repo
#   APPLE_TEAM_ID                                  Art's Team ID
# Nothing here prints them.

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  desc "Unsigned simulator build, to check the app compiles (no secrets needed)"
  lane :simulator do
    sh("cd .. && xcodegen")
    xcodebuild(
      project: "TowerScope.xcodeproj",
      scheme: "TowerScope",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
    )
  end

  desc "Signed App Store build, uploaded to TestFlight (needs the secrets above)"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = asc_key
    sh("cd .. && xcodegen")
    match(type: "appstore", readonly: true, api_key: api_key)
    increment_build_number(
      xcodeproj: "TowerScope.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(api_key: api_key) + 1,
    )
    build_app(
      project: "TowerScope.xcodeproj",
      scheme: "TowerScope",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Manual " \
              "PROVISIONING_PROFILE_SPECIFIER='match AppStore io.towerscope.live' CODE_SIGN_IDENTITY='Apple Distribution'",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
