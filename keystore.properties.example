# Copy this file to keystore.properties (same folder) and fill it in to sign release builds locally.
# keystore.properties is in .gitignore, so your passwords stay on this computer. Never commit it.
#
# Environment variables win when they are set (CI uses them):
#   TOWERSCOPE_KEYSTORE, TOWERSCOPE_KEYSTORE_PASSWORD, TOWERSCOPE_KEY_ALIAS, TOWERSCOPE_KEY_PASSWORD
# You can also keep this file somewhere else and point TOWERSCOPE_KEYSTORE_PROPERTIES at it.
#
# With no key configured, release builds are signed with the debug key. They run fine, but they can't
# update an app installed from a signed release, and Google Play won't accept them.

# Full path to the .jks file
storeFile=
storePassword=
keyAlias=
keyPassword=
