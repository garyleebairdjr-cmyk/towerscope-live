<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10 and 11 read this instead of data_extraction_rules.xml. Keep the two in step. -->
<full-backup-content>
    <exclude domain="sharedpref" path="towerscope.xml" />
    <exclude domain="file" path="history.tsv" />
    <exclude domain="file" path="history.tsv.tmp" />
    <exclude domain="file" path="history-backup.tsv.tmp" />
</full-backup-content>
